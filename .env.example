# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, digits only (e.g. 9715XXXXXXXX).
# The live site publishes no WhatsApp number (BLOCKER-1). Leave empty until the client supplies it;
# the floating button then falls back to WhatsApp's share link with the pre-filled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=
